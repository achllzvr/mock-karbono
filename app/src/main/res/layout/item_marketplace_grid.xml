<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced marketplace item with consistent styling -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="@dimen/spacing_small"
    android:background="@drawable/bg_card_hard_shadow"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Image with rounded top corners -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgItemCover"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:scaleType="centerCrop"
        android:src="@drawable/img_mangrove"
        android:background="@color/progress_background"
        app:shapeAppearanceOverlay="@style/RoundedTopImage"/>

    <!-- Content Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding_compact">

        <!-- Title -->
        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Goal Title"
            android:textSize="@dimen/text_size_body_large"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_dark"
            android:maxLines="2"
            android:ellipsize="end"/>

        <!-- Price Info -->
        <TextView
            android:id="@+id/tvItemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="₱0 / ₱0"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/text_secondary"/>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressGoal"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="@dimen/spacing_medium"
            android:progressDrawable="@drawable/bg_progress_bar_green"
            android:progress="0"
            android:max="100"/>

        <!-- Impact/Percentage -->
        <TextView
            android:id="@+id/tvItemImpact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="0% Funded"
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/matcha_green"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <!-- Contribute Button -->
        <Button
            android:id="@+id/btnContribute"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_compact"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/btn_contribute"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_green"
            android:textColor="@android:color/white"
            android:elevation="0dp"/>

    </LinearLayout>

</LinearLayout>