<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced leaderboard item with Duolingo-style card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_medium"
    android:background="@drawable/bg_card_hard_shadow"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/card_padding_compact"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Rank Badge -->
    <TextView
        android:id="@+id/tvRank"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="1"
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:gravity="center"
        android:background="@drawable/bg_circle_card"
        android:elevation="@dimen/elevation_low"/>

    <!-- Avatar -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/bg_avatar_circle"
        android:layout_marginStart="@dimen/spacing_medium"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/CircleImageStyle"
        app:strokeWidth="2dp"
        app:strokeColor="@color/divider"/>

    <!-- User Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/spacing_medium">

        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textSize="@dimen/text_size_body_large"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvCarbonScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="125 kg saved"
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="@dimen/spacing_tiny"/>

    </LinearLayout>

    <!-- Streak Badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_pill_green"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingVertical="@dimen/spacing_small">

        <ImageView
            android:layout_width="@dimen/icon_size_small"
            android:layout_height="@dimen/icon_size_small"
            android:src="@drawable/ic_streak"
            app:tint="@color/matcha_green"/>

        <TextView
            android:id="@+id/tvStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/matcha_green"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/spacing_tiny"/>

    </LinearLayout>

</LinearLayout>